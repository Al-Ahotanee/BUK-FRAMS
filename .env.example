# Database Connection (PostgreSQL)
# For production on Vercel or local PostgreSQL (e.g. Supabase, Neon, Railway):
DATABASE_URL="postgresql://postgres:password@localhost:5432/buk_attendance?sslmode=prefer"

# Example for Supabase:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# For production on Vercel with MySQL (e.g. PlanetScale, TiDB Cloud):
# DATABASE_URL="mysql://user:password@host:3306/buk_attendance?sslaccept=strict"

# Secret key for JWT sessions
SESSION_SECRET="buk_attendance_secret_jwt_key_2026_super_secure"

# Cloud Object Storage (S3 / R2 / Neon / Supabase S3)
# (Optional: If omitted, system seamlessly uses secure local upload fallback)
S3_BUCKET_NAME="buk-attendance-storage"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_key"
# Optional custom S3 endpoint (e.g. for Cloudflare R2, MinIO, or Supabase Storage):
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_PUBLIC_DOMAIN="https://cdn.buk.edu.ng"

