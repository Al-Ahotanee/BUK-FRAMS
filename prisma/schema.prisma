datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String   @default("")
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Faculty {
  id             Int        @id @default(autoincrement())
  facultyName    String
  facultyCode    String     @unique
  createdAt      DateTime   @default(now())
  courses        Course[]
  venues         Venue[]
  lecturers      Lecturer[]
}

model Course {
  id          Int       @id @default(autoincrement())
  name        String
  courseCode  String    @unique
  facultyId   Int
  faculty     Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  units       Unit[]
  students    Student[]
  createdAt   DateTime  @default(now())
}

model Unit {
  id                  Int            @id @default(autoincrement())
  name                String
  unitCode            String         @unique
  courseId            Int
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturerAssignments LecturerUnit[]
  studentAssignments  StudentUnit[]
  attendances         Attendance[]
  excuses             AbsenceExcuse[]
  createdAt           DateTime       @default(now())
}

model Venue {
  id             Int      @id @default(autoincrement())
  className      String   @unique
  facultyCode    String?
  facultyId      Int?
  faculty        Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  currentStatus  String   @default("available")
  capacity       Int      @default(50)
  classification String   @default("Lecture Theatre")
  createdAt      DateTime @default(now())
}

model Lecturer {
  id              Int            @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String         @unique
  password        String
  phoneNo         String?
  facultyCode     String?
  facultyId       Int?
  faculty         Faculty?       @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  unitAssignments LecturerUnit[]
  createdAt       DateTime       @default(now())
}

model Student {
  id                 Int             @id @default(autoincrement())
  firstName          String
  lastName           String
  registrationNumber String          @unique
  email              String          @unique
  password           String          @default("$2a$10$wE8q67x1y8u0eC/N6aL6bO2kQcM.E9J4w5eQ7rY1tU2iO3pA4sD5G") // Default hashed '@student123'
  faculty            String
  courseCode         String
  courseId           Int?
  course             Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studentImage       String?         // Primary photo (DataURL or URL)
  faceDescriptors    String?         // JSON-encoded array of 128-d float embedding vectors
  unitAssignments    StudentUnit[]
  attendances        Attendance[]
  excuses            AbsenceExcuse[]
  createdAt          DateTime        @default(now())
}

model LecturerUnit {
  id           Int      @id @default(autoincrement())
  lecturerId   Int
  lecturer     Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  unitId       Int
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  dateAssigned DateTime @default(now())

  @@unique([lecturerId, unitId])
}

model StudentUnit {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unitId       Int
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  dateAssigned DateTime @default(now())

  @@unique([studentId, unitId])
}

model Attendance {
  id                        Int      @id @default(autoincrement())
  studentRegistrationNumber String
  studentId                 Int?
  student                   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseCode                String
  unitCode                  String
  unitId                    Int?
  unit                      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  venue                     String?
  attendanceStatus          String   @default("Present")
  timeMarked                String?
  dateMarked                DateTime @default(now())

  @@index([studentRegistrationNumber, unitCode, dateMarked])
}

model AbsenceExcuse {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unitId      Int
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reason      String   // "Medical", "Compassionate", "University Official", "Exam Clash", "Other"
  description String
  documentUrl String?  // Supporting document or doctor's report in S3/cloud storage
  dateMissed  DateTime
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes  String?
  reviewedBy  String?  // Admin or Lecturer email
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, unitId, status])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorRole  String   // ADMIN, LECTURER, STUDENT
  actorEmail String
  action     String   // e.g. "USER_LOGIN", "EXCUSE_SUBMITTED", "EXCUSE_APPROVED", "ATTENDANCE_RECORDED"
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorRole, action, createdAt])
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  recipient String
  subject   String
  message   String
  status    String   @default("sent")
  createdAt DateTime @default(now())
}

